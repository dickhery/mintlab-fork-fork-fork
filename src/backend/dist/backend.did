   (SettlementEscrowRepairQuote);
  adminHideCollection: (collectionId: CollectionId) ->
   (variant {
      err: text;
      ok: CollectionImportMeta;
    });
  adminListMarketplaceRecoveryState: () ->
   (MarketplaceRecoverySnapshot) query;
  adminMarkCollectionNeedsBrowseInfo: (collectionId: CollectionId) ->
   (variant {
      err: text;
      ok: CollectionImportMeta;
    });
