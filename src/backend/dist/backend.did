 };
type UserId = principal;
type TransferResult = 
 variant {
   Err: TransferError;
   Ok: nat64;
 };
type TransferError = 
 variant {
   BadFee: record {expected_fee: Tokens;};
   InsufficientFunds: record {balance: Tokens;};
