   nat64, name: text, description: text, symbol: text, imageUrl: text,
   dividendsEnabled: bool) ->
   (variant {
      err: text;
      ok: CollectionCreationReceipt;
    });
  adminReleaseDividendClaimLock: (collectionId: CollectionId, tokenId:
   text) -> (variant {
               err: text;
               ok: bool;
             });
  adminReleaseDividendDisbursementLock: (collectionId: CollectionId) ->
   (variant {
      err: text;
      ok: bool;
    });
  adminResetUnresolvedMintlabFeeAttempt: (listingId: ListingId) ->
   (MintlabFeeRecoveryQuote);
  adminResolvePendingBid: (listingId: ListingId) -> (MarketplaceActionResult);
  adminRetryAuctionSettlement: (listingId: ListingId) ->
   (MarketplaceActionResult);
  adminRetryFixedPurchaseSettlement: (listingId: ListingId) ->
   (MarketplaceActionResult);
  adminRetryListingReturn: (listingId: ListingId) ->
   (MarketplaceActionResult);
  adminRetryNoBidAuctionReturn: (listingId: ListingId) ->
   (MarketplaceActionResult);
  adminTopUpSettlementEscrow: (listingId: ListingId, amount: nat64) ->
   (SettlementEscrowTopUpReceipt);
  adminVerifyCollection: (collectionId: CollectionId) ->
   (variant {
      err: text;
      ok: CollectionImportMeta;
    });
  balance: (request: EXTBalanceRequest) -> (EXTBalanceResponse) query;
  bootstrapAdmin: () -> ();
  buyFixedListing: (listingId: ListingId) -> (MarketplaceActionResult);
  cancelListing: (listingId: ListingId) -> (MarketplaceActionResult);
  cancelStalePendingBid: (listingId: ListingId) -> (MarketplaceActionResult);
  claimNFTDividend: (nftId: NFTId) ->
   (variant {
      err: text;
      ok: DividendClaimReceipt;
    });
  claimVaultDeposit: (collectionId: CollectionId, tokenId: text) ->
   (variant {
      err: text;
      ok: WalletNFT;
    });
  configureMarketplaceFee: (recipient: opt AccountIdentifier,
   mintlabFeeBasisPoints: nat) -> (MarketplaceFeeConfig);
  configureMarketplaceFeeRecipient: (recipient: opt AccountIdentifier) ->
   (MarketplaceFeeConfig);
  configureMinting: (name: text, description: text, symbol: text, imageUrl:
   text, collectionCreationPayoutAccount: opt AccountIdentifier,
   collectionCreationSecondaryPayoutAccount: opt AccountIdentifier,
   collectionCreationPrimaryPayoutBasisPoints: nat,
   collectionCreationSecondaryPayoutBasisPoints: nat,
   collectionCreationPriceE8s: nat64, collectionCreationEnabled: bool,
   mainMintPayoutAccount: opt AccountIdentifier, mainMintPriceE8s: nat64,
   mainMintEnabled: bool, mainMintDividendsEnabled: bool,
   collectionCanisterCycles: nat) -> (Collection);
  configureModeration: (enabled: bool, apiKey: opt text, clearApiKey: 
   bool, model: text, categories: ModerationCategorySettings, userMessage:
   text) -> (PublicModerationConfig);
  createAuctionListing: (nftId: NFTId, startingBid: nat64, endTime: int) ->
   (AuctionListing);
  createFixedListing: (nftId: NFTId, price: nat64) -> (FixedListing);
  createUserCollection: (name: text, description: text, symbol: text,
   imageUrl: text, dividendsEnabled: bool) ->
   (variant {
      err: text;
      ok: CollectionCreationReceipt;
    });
  dip721_owner_token_identifiers: (owner: principal) ->
   (DIP721TokensResult) query;
  dip721_token_metadata: (token_id: nat) -> (DIP721MetadataResult) query;
  disburseCollectionDividends: (collectionId: CollectionId, maxTransfers:
   opt nat) -> (variant {
                  err: text;
                  ok: DividendDisbursementReceipt;
                });
  ext_balance: (request: EXTBalanceRequest) -> (EXTBalanceResponse) query;
  ext_bearer: (tokenIdentifier: EXTTokenIdentifier) ->
   (variant {
      err: EXTCommonError;
      ok: EXTAccountIdentifier;
    }) query;
  ext_extensions: () -> (vec text) query;
  ext_metadata: (tokenIdentifier: EXTTokenIdentifier) ->
   (EXTMetadataResult) query;
  ext_transfer: (request: EXTTransferRequest) -> (EXTTransferResponse);
  extdata_supply: (tokenIdentifier: EXTTokenIdentifier) ->
   (variant {
      err: EXTCommonError;
      ok: EXTBalance;
    }) query;
  extensions: () -> (vec text) query;
  getActiveListingDetails: () -> (vec ActiveListingDetail) query;
  getActiveListingDetailsPage: (cursor: opt nat, limit: opt nat) ->
   (ActiveListingDetailPage) query;
  getActiveListings: () -> (vec ActiveListing) query;
  getActiveListingsPage: (cursor: opt nat, limit: opt nat) ->
   (ActiveListingPage) query;
  getAdminPrincipal: () -> (opt principal) query;
  getAllCollectionCreationRequests: () ->
