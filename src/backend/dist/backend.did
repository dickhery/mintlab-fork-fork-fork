  getMyCollectionCanisterStatuses: () -> (vec CollectionCanisterStatus);
  getMyCollectionCreationRequests: () ->
   (vec CollectionCreationRequestView) query;
  getMyCollectionCreationRequestsPage: (cursor: opt nat, limit: opt nat) ->
   (CollectionCreationRequestPage) query;
  getMyCreatedCollections: () -> (vec Collection);
  getMyDividendNFTs: () -> (vec NFTDividend);
  getMyDividendNFTsPage: (cursor: opt nat, limit: opt nat) ->
   (NFTDividendPage);
  getMyMarketplaceSettlementStatuses: () -> (vec SettlementStatus) query;
  getMyMarketplaceSettlementStatusesPage: (cursor: opt nat, limit:
   opt nat) -> (SettlementStatusPage) query;
  getMyPendingAuctionRefunds: () -> (vec AuctionEscrow) query;
  getMyPendingMintPayments: () -> (vec PendingMintPaymentView) query;
  getNFTStats: (user: principal) -> (NFTStats) query;
  getRegistry: () -> (vec record {
                            EXTTokenIndex;
                            EXTAccountIdentifier;
                          }) query;
  getTokens: () -> (vec record {
                          EXTTokenIndex;
                          EXTMetadataLegacy;
                        }) query;
  getUserAccountId: () -> (AccountIdentifier) query;
  getUserICPBalance: () -> (nat64);
  getUserNFTs: (user: principal) -> (vec WalletNFT) query;
  getUserNFTsPage: (user: principal, cursor: opt nat, limit: opt nat) ->
