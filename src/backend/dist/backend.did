 };
type ActiveListingPage = 
 record {
   listings: vec ActiveListing;
   nextCursor: opt nat;
   totalCount: nat;
 };
type ActiveListingDetailPage = 
 record {
   details: vec ActiveListingDetail;
   nextCursor: opt nat;
   totalCount: nat;
 };
type ActiveListingDetail = 
 record {
   listing: ActiveListing;
   nft: WalletNFT;
 };
type ActiveListing = 
 variant {
   Auction: AuctionListing;
   Fixed: FixedListing;
 };
type AccountIdentifier = blob;
service : {
  addCollection: (name: text, description: text, canisterId: principal,
   standard: NFTStandard, imageUrl: text, symbol: text, browseInfo:
   opt CollectionBrowseInfo) -> (Collection);
  addCollectionCanisterController: (collectionId: CollectionId, controller:
   principal) -> (variant {
                    err: text;
                    ok: CollectionCanisterControllers;
                  });
  adminAttachExistingCanisterToCreationRequest: (requestId: nat,
   childCanisterId: principal) ->
   (variant {
      err: text;
      ok: CollectionCreationReceipt;
    });
  adminBlockCollection: (collectionId: CollectionId) ->
   (variant {
      err: text;
      ok: CollectionImportMeta;
    });
  adminDeleteCollectionCreationRequest: (requestId: nat) ->
   (variant {
      err: text;
      ok: bool;
    });
